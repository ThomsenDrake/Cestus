  "compositionCorpus": {
    "version": "task136-composition-corpus.v1",
    "accepted": [
      {
        "id": "accepted-generated-composition",
        "category": "accepted",
        "description": "Generated fixture source from a manifest containing only supported templates, static named imports, and explicit named exports."
      }
    ],
    "rejected": [
      {
        "id": "unknown-node",
        "category": "unknown-node",
        "description": "Rejects a release card whose ID is not in the frozen graph."
      },
      {
        "id": "duplicate-node",
        "category": "duplicate-node",
        "description": "Rejects duplicate release card IDs."
      },
      {
        "id": "reordered-node",
        "category": "reordered-node",
        "description": "Rejects graph cards that are not in the frozen topological order."
      },
      {
        "id": "missing-prerequisite",
        "category": "missing-prerequisite",
        "description": "Rejects removal of a declared prerequisite edge."
      },
      {
        "id": "dependency-inversion",
        "category": "dependency-inversion",
        "description": "Rejects a prerequisite that appears after its consumer."
      },
      {
        "id": "undeclared-transfer",
        "category": "undeclared-transfer",
        "description": "Rejects a transferred path without a declared transfer target."
      },
      {
        "id": "overlapping-final-owner",
        "category": "overlapping-final-owner",
        "description": "Rejects two final owners for the same owned path."
      },
      {
        "id": "missing-owned-path",
        "category": "missing-owned-path",
        "description": "Rejects removal of an owned or transferred path from a card."
      },
      {
        "id": "extra-owned-path",
        "category": "extra-owned-path",
        "description": "Rejects paths outside the frozen card inventory."
      },
      {
        "id": "wrong-path-disposition",
        "category": "wrong-path-disposition",
        "description": "Rejects a path whose owned/transferred disposition changes."
      },
      {
        "id": "noncanonical-module-path",
        "category": "noncanonical-module-path",
        "description": "Rejects fixture modules whose path is not canonical."
      },
      {
        "id": "unsupported-template",
        "category": "unsupported-template",
        "description": "Rejects fixture manifests that name a template outside the five supported templates."
      },
      {
        "id": "unknown-import",
        "category": "unknown-import",
        "description": "Rejects imports from modules outside the fixture manifest."
      },
      {
        "id": "wrong-import-kind",
        "category": "wrong-import-kind",
        "description": "Rejects value/type import kind mismatches."
      },
      {
        "id": "missing-export",
        "category": "missing-export",
        "description": "Rejects removal of an expected explicit named export."
      },
      {
        "id": "extra-export",
        "category": "extra-export",
        "description": "Rejects an export outside the frozen manifest."
      },
      {
        "id": "default-import",
        "category": "default-import",
        "description": "Rejects default imports in generated fixture modules."
      },
      {
        "id": "namespace-import",
        "category": "namespace-import",
        "description": "Rejects namespace imports in generated fixture modules."
      },
      {
        "id": "dynamic-commonjs-loader",
        "category": "dynamic-commonjs-loader",
        "description": "Rejects dynamic import or CommonJS loading forms."
      },
      {
        "id": "fixture-source-outside-generator",
        "category": "fixture-source-outside-generator",
        "description": "Rejects arbitrary fixture source that was not produced from the manifest generator."
      }
    ]
  }
