{
  "name": "cestus",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "ui:build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && echo 'typecheck passed'",
    "factory:check": "node scripts/check-agent-readiness.mjs",
    "ingestion:help": "node packages/ingestion/bin/cestus-ingest.mjs ingest --help",
    "workspace:help": "node packages/workspace-ops/bin/cestus-workspace.mjs --help",
    "workspace:ops": "NODE_NO_WARNINGS=1 tsx packages/workspace-ops/src/node-cli.ts",
    "verify": "npm run typecheck && npm test && echo 'tests passed' && npm run ui:build && npm run factory:check",
    "local:runtime": "tsx packages/local-runtime/src/cli.ts serve",
    "local:runtime:configure": "tsx packages/local-runtime/src/cli.ts configure",
    "local:runtime:config": "tsx packages/local-runtime/src/cli.ts config",
    "local:runtime:health": "tsx packages/local-runtime/src/cli.ts health",
    "local:workspace:create": "tsx packages/local-runtime/src/cli.ts create-workspace",
    "local:workspace:smoke": "node --disable-warning=ExperimentalWarning --import tsx packages/local-runtime/src/workspace-readiness-smoke.ts",
    "agent:nous:smoke": "node --disable-warning=ExperimentalWarning --import tsx packages/local-runtime/src/agent-nous-smoke.ts",
    "prr:seed-local": "tsx packages/local-runtime/src/cli.ts seed-prr"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.2.8",
    "fflate": "^0.8.3",
    "@heroicons/react": "^2.2.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "zod": "^4.2.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26.0.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4.3.2",
    "tsx": "^4.23.0",
    "typescript": "^5.9.0",
    "vite": "^8.1.3",
    "vitest": "^4.0.0"
  }
}
